# Document CV Pipeline — Environment Config
# Copy to .env and adjust values

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2
LOG_LEVEL=INFO

# Pipeline Settings
OCR_LANGUAGES=en
USE_GPU=false
MAX_FILE_SIZE_MB=20
MIN_OCR_CONFIDENCE=0.3

# Database
DB_PATH=database/doc_cv.db

# Model paths (optional — uses heuristics if not set)
YOLO_MODEL_PATH=
CLASSIFIER_MODEL_PATH=models/classifier.pkl

# Streamlit
STREAMLIT_PORT=8501
API_URL=http://localhost:8000

